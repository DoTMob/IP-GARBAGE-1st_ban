[Unit]
Description=autoban — adaptive log-driven IP ban daemon
Documentation=file:/opt/autoban/README.md
After=network-online.target nginx.service apache2.service
Wants=network-online.target
ConditionPathExists=/opt/autoban/autoban.sh
ConditionPathExists=/etc/autoban/autoban.conf

[Service]
Type=simple
ExecStart=/opt/autoban/autoban.sh --config /etc/autoban/autoban.conf run
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s

# Root is required for ipset/iptables. The sandbox below keeps the blast
# radius small: no home access, private /tmp, restricted address families,
# and explicit read/write paths.
User=root
StateDirectory=autoban
StateDirectoryMode=0750
RuntimeDirectory=autoban
RuntimeDirectoryMode=0750
LogsDirectory=autoban
LogsDirectoryMode=0750
ConfigurationDirectory=autoban

NoNewPrivileges=no
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
LimitNOFILE=8192
LimitNPROC=256

# Paths autoban.sh needs to read (logs, config, lists) and write (state,
# event log, runtime). Adjust ReadOnlyPaths if your web server logs live
# somewhere other than /var/log/nginx or /var/log/apache2.
ReadOnlyPaths=/var/log/nginx /var/log/apache2 /etc/autoban
ReadWritePaths=/var/lib/autoban /var/log/autoban /run/autoban

[Install]
WantedBy=multi-user.target
